# Runtime config - contains real Wi-Fi passwords, Bluetooth MAC, hotspot
# password. Never commit this; use config.example.json as a template.
config.json

# User-supplied azan/dua recordings - not redistributed with the repo.
audio/*
!audio/.gitkeep

# Generated at runtime
timetable.csv
quran_state.json
history.jsonl

# Self-signed HTTPS cert - host-specific (covers this machine's LAN IPs),
# regenerate per install with gen_https_cert.sh
cert.pem
cert.key
__pycache__/
*.pyc
venv/
*.log
