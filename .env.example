# Copy to .env (install_docker.sh does this for you interactively).
# Never commit the real .env - it's gitignored.

# Random secret Flask uses to sign session cookies. Generate with:
#   openssl rand -hex 32
FLASK_SECRET_KEY=

# Leave blank for no login at all (fine for LAN-only use). Set this before
# exposing the app to the public internet.
SMART_AZAN_ADMIN_PASSWORD=
