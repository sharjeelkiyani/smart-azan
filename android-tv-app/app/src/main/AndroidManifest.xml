<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Lets the background watcher draw the azan display on top of
         whatever else is on screen (see AzanOverlayService) - this is a
         sensitive permission Android requires the user to grant manually
         via Settings, it can't be silently auto-granted. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Both required="false" so this same APK installs and shows up on a
         Fire TV/Android TV home screen (leanback) AND a regular phone. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- usesCleartextTraffic: the TV display is deliberately served over
         plain HTTP (see app.py's tv_http_app) since WebView's fetch()/XHR
         calls don't honor onReceivedSslError the way page navigation does -
         polling /tv_status over the main site's self-signed HTTPS would
         otherwise fail silently. Android blocks cleartext by default on
         API 28+, so this has to be explicit. -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Fullscreen"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Makes the app appear on the Fire TV/Android TV home screen row -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Watches for a new azan/dua even while some other app is on
             screen, and draws it full-screen on top (needs the overlay
             permission granted once - see MainActivity). -->
        <service
            android:name=".AzanOverlayService"
            android:exported="false" />

        <!-- Optional Fire TV/Android TV screensaver - shows the same
             display during idle time. Chosen manually in
             Settings -> Display & Sounds -> Screen Saver. Only activates
             when the device is idle, not over actively playing content -
             that's what AzanOverlayService is for. -->
        <service
            android:name=".TvDreamService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

    </application>
</manifest>
